# ---------------------------------------------------------------------------
# AES Inference Lab — configuration
# Copy to .env and adapt. Every variable has a sensible default.
# ---------------------------------------------------------------------------

# --- inference service addresses ------------------------------------------
# Inside Docker use host.docker.internal to reach services listening on
# 127.0.0.1 of the host machine. Outside Docker use localhost.
GATEWAY_URL=http://host.docker.internal:8091/v1
COLIBRI_URL=http://host.docker.internal:8070/v1
LLAMA_SWAP_URL=http://host.docker.internal:8081/v1
LLAMA_EMBED_URL=http://host.docker.internal:8082/v1

# LiteLLM gateway key, if you have set one
LITELLM_MASTER_KEY=

# model identifiers used as defaults in the forms
COLIBRI_MODEL_ID=glm52
EMBED_MODEL_ID=embed

# --- resource monitoring --------------------------------------------------
# path where the models live: used to read the disk space
MODELS_PATH=/srv/models
# to see the HOST's RAM and page cache and not the container's, mount /proc
# (see docker-compose.yml) and leave this value
HOST_PROC=/host/proc

# --- application ----------------------------------------------------------
LAB_PORT=8500
LAB_CONFIG=config/endpoints.yml
LAB_DB_PATH=data/lab.sqlite3
HEALTH_TIMEOUT_S=5

# --- demo without a real server -------------------------------------------
# set true and start with --profile demo to use the simulated engine
MOCK_ENABLED=false
MOCK_URL=http://mock:9000/v1
