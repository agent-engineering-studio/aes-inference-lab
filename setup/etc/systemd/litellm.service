[Unit]
Description=LiteLLM gateway (routing per nome modello)
After=network-online.target
# Un crash loop deve fermarsi ed essere visibile, non consumare la macchina.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# Due file: i segreti condivisi (COLI_API_KEY) e quelli del solo gateway
# (ANTHROPIC_API_KEY). Nessuno dei due finisce in una Environment=.
EnvironmentFile=${SECRETS_FILE}
EnvironmentFile=-/etc/litellm/env
ExecStart=${OPT_DIR}/litellm/venv/bin/litellm --config /etc/litellm/config.yaml --host ${LITELLM_HOST} --port ${PORT_LITELLM}
Restart=always
RestartSec=10
MemoryHigh=2G
Nice=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
