[Unit]
Description=LiteLLM gateway (routing per nome modello)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/litellm/env
ExecStart=${OPT_DIR}/litellm/venv/bin/litellm --config /etc/litellm/config.yaml --host 0.0.0.0 --port ${PORT_LITELLM}
Restart=always
RestartSec=5
MemoryHigh=2G
Nice=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
