# ─────────────────────────────────────────────────────────────
#  aes-server — configuration
#  Copy to .env and adapt. No secret should be committed.
# ─────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────
PORT_COLIBRI=8070          # coli serve
PORT_LLAMA_SWAP=8081       # llama-swap (small models on GPU)
PORT_EMBED=8082            # llama-server embedding, always resident
PORT_LITELLM=8091          # single gateway: the projects point here

# ── Paths (must already be mounted) ──────────────────────────
MODELS_DIR=/srv/models
COLIBRI_MODEL_DIR=/srv/models/colibri/glm52_i4
GGUF_DIR=/srv/models/gguf
ARCHIVE_DIR=/srv/archive
HF_HOME=/srv/archive/hf
OPT_DIR=/opt

# ── GPU ──────────────────────────────────────────────────────
# Quadro RTX 4000 = Turing = 75. Derive it with:
#   nvidia-smi --query-gpu=compute_cap --format=csv,noheader
CUDA_ARCH=75
# colibrì's Makefile passes this value to nvcc as -arch=:
# it wants 'native' or 'sm_75', not the bare number.
COLI_CUDA_ARCH=native
# 0 = the GPU goes to the small models (Turing+). On Pascal (6.1) raise to 6.
COLI_CUDA_EXPERT_GB=0

# ── colibrì: 'coli serve' options ────────────────────────────
# Name exposed by the API. MUST match the one in the LiteLLM config.
COLI_MODEL_ID=glm52
# VRAM budget in GB (0=auto). With an 8 GB card, 2 leaves ~6 GB to llama.cpp.
COLI_VRAM_GB=2
# Concurrent conversations with persistent KV state.
COLI_KV_SLOTS=2
# quality | balanced | experimental-fast
COLI_POLICY=balanced

# ── NUMA ─────────────────────────────────────────────────────
# CPUs to pin llama.cpp to. Empty = autodetect socket 1.
SOCKET1_CPUS=

# ── Models ───────────────────────────────────────────────────
HF_GLM_REPO=mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp

HF_EMBED_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
HF_EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf

# Check which releases exist TODAY before filling these in.
# The script fails with a clear message if they are empty.
HF_CHAT4B_REPO=
HF_CHAT4B_FILE=
HF_CHAT8B_REPO=
HF_CHAT8B_FILE=

# ── Contexts and VRAM ────────────────────────────────────────
CTX_CHAT4B=32768
CTX_CHAT8B=16384
CTX_EXTRACT=8192
PARALLEL_EXTRACT=8

# ── LiteLLM ──────────────────────────────────────────────────
LITELLM_MAX_BUDGET=50       # USD, safety net against loops
LITELLM_BUDGET_DURATION=30d
LITELLM_CLOUD_MODEL=anthropic/claude-sonnet-5
# Leave empty to disable the cloud tier. Do not commit.
ANTHROPIC_API_KEY=

# ── Docker ───────────────────────────────────────────────────
DOCKER_MEMORY_HIGH=7G
DOCKER_MEMORY_MAX=10G
