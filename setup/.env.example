# ─────────────────────────────────────────────────────────────
#  aes-server — configuration
#  Copy to .env and adapt. No secret should be committed.
# ─────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────
PORT_COLIBRI=8070          # coli serve
PORT_LLAMA_SWAP=8081       # llama-swap (small models on GPU)
PORT_EMBED=8082            # llama-server embedding, always resident
PORT_LITELLM=8091          # single gateway: the projects point here

# ── Docker networks of the projects that consume inference ───
# They get the LiteLLM gateway ONLY, never the direct ports: routing by
# model name, budget and fallback live in the gateway, and a direct port
# bypasses all of it. Space-separated docker network names.
GATEWAY_CLIENT_NETS=

# Subnets allowed to reach the inference ports, comma-separated. These are
# the bridges the containers actually come from: a container reaches the
# host through the bridge address (host.docker.internal), never through its
# loopback. Used verbatim by 45-firewall.sh when a network name cannot be
# inspected, and always as an extra set of sources.
DOCKER_SUBNETS=172.28.0.0/24,172.19.0.0/16

# ── Secrets ──────────────────────────────────────────────────
# Shared env file read by every unit (EnvironmentFile=). Created by phase 40
# with 0640 root:inference, and never rewritten once it exists.
SECRETS_FILE=/etc/inference/secrets.env
# Leave empty: phase 40 generates one with `openssl rand -hex 32` on the
# first run and stores it in SECRETS_FILE. Fill it in only to pin a specific
# key. Do not commit.
COLI_API_KEY=
# Extra names accepted by colibri's DNS-rebinding guard, on top of loopback
# and the bind address: a container sends 'host.docker.internal' as Host and
# would otherwise get a 403.
COLI_ALLOWED_HOSTS=host.docker.internal

# ── Listening addresses ──────────────────────────────────────
# 0.0.0.0 is the working default, not an opening towards the LAN: a
# container cannot reach the host's loopback in any configuration, so
# 127.0.0.1 would leave the dashboard with the gateway alone. The boundary
# is ufw, which allows these ports only from DOCKER_SUBNETS.
#
# Any COLI_HOST other than 127.0.0.1 REQUIRES COLI_API_KEY: colibri refuses
# to bind beyond localhost without it and exits 1. Never work around this
# with COLI_ALLOW_INSECURE_BIND=1 -- phase 40 refuses to run if it is set.
COLI_HOST=0.0.0.0
LLAMA_SWAP_HOST=0.0.0.0
LLAMA_EMBED_HOST=0.0.0.0
LITELLM_HOST=0.0.0.0
# Legacy single knob: still honoured as the fallback for the four variables
# above when they are not set. Prefer the per-service ones.
#BIND_ADDR=0.0.0.0

# ── Paths (must already be mounted) ──────────────────────────
MODELS_DIR=/srv/models
COLIBRI_MODEL_DIR=/srv/models/colibri/glm52_i4
GGUF_DIR=/srv/models/gguf
ARCHIVE_DIR=/srv/archive
HF_HOME=/srv/archive/hf
OPT_DIR=/opt

# ── GPU ──────────────────────────────────────────────────────
# Quadro RTX 4000 = Turing = 75. Derive it with:
#   nvidia-smi --query-gpu=compute_cap --format=csv,noheader
CUDA_ARCH=75
# colibrì's Makefile passes this value to nvcc as -arch=:
# it wants 'native' or 'sm_75', not the bare number.
COLI_CUDA_ARCH=native
# 0 = the GPU goes to the small models (Turing+). On Pascal (6.1) raise to 6.
COLI_CUDA_EXPERT_GB=0

# ── colibrì: 'coli serve' options ────────────────────────────
# Name exposed by the API. MUST match the one in the LiteLLM config.
COLI_MODEL_ID=glm52
# VRAM budget in GB (0=auto). With an 8 GB card, 2 leaves ~6 GB to llama.cpp.
COLI_VRAM_GB=2
# Concurrent conversations with persistent KV state.
COLI_KV_SLOTS=2
# quality | balanced | experimental-fast
COLI_POLICY=balanced

# ── NUMA ─────────────────────────────────────────────────────
# CPUs to pin llama.cpp to. Empty = autodetect socket 1.
SOCKET1_CPUS=

# ── Models ───────────────────────────────────────────────────
HF_GLM_REPO=mastouri/GLM-5.2-colibri-int4-g64-with-int8-mtp

HF_EMBED_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
HF_EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf

# Check which releases exist TODAY before filling these in.
# The script fails with a clear message if they are empty.
HF_CHAT4B_REPO=
HF_CHAT4B_FILE=
HF_CHAT8B_REPO=
HF_CHAT8B_FILE=

# ── Contexts and VRAM ────────────────────────────────────────
CTX_CHAT4B=32768
CTX_CHAT8B=16384
CTX_EXTRACT=8192
PARALLEL_EXTRACT=8

# ── LiteLLM ──────────────────────────────────────────────────
LITELLM_MAX_BUDGET=50       # USD, safety net against loops
LITELLM_BUDGET_DURATION=30d
LITELLM_CLOUD_MODEL=anthropic/claude-sonnet-5
# Leave empty to disable the cloud tier. Do not commit.
ANTHROPIC_API_KEY=

# ── Docker ───────────────────────────────────────────────────
DOCKER_MEMORY_HIGH=7G
DOCKER_MEMORY_MAX=10G
